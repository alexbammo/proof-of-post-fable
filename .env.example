# Copy to .env.local (git-ignored). Names only here, never values.

# App
PORT=3002
APP_URL=http://localhost:3002
ADMIN_TOKEN=            # protects /admin and the demo clock

# Database: leave DATABASE_URL empty to use the embedded PGlite file at ./data/pglite
DATABASE_URL=

# PayPal sandbox (this build's own app)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_ENV=sandbox
PAYPAL_BN_CODE=         # optional partner attribution id

# AI
ANTHROPIC_API_KEY=

# Platforms
YOUTUBE_API_KEY=
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
